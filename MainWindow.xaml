<Window x:Class="CHZMFRAMEUNLOCK1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CHZM Frame Unlock"
        Icon="app.ico"
        Width="1280" Height="820"
        MinWidth="1100" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize" Background="#030303"
        WindowStartupLocation="CenterScreen"
        FontFamily="Consolas" FontSize="10" Foreground="#FFFFFF"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        ToolTipService.InitialShowDelay="150"
        ToolTipService.ShowDuration="20000"
        PreviewKeyDown="Window_PreviewKeyDown"
        Opacity="0">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="#030303" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Grid Grid.Row="0" x:Name="DragArea" Background="Transparent"
                  MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <TextBlock Text="C H Z M   F R A M E   U N L O C K"
                           FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                           Foreground="#FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="HeaderGameText" Text="NO GAME SELECTED"
                               FontFamily="Consolas" FontSize="9" Foreground="#666666"
                               VerticalAlignment="Center" Margin="0,0,14,0"
                               MaxWidth="320" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="—" Style="{StaticResource IconText}"
                               MouseLeftButtonDown="Minimize_Click" ToolTip="Свернуть в трей" />
                    <Grid Width="14" Height="14" Margin="6,0,0,0" Cursor="Hand"
                          MouseLeftButtonDown="Maximize_Click" ToolTip="Развернуть / восстановить окно">
                        <Path x:Name="MaximizeGlyph" Data="M 1,1 L 9,1 L 9,9 L 1,9 Z"
                              Stroke="#666666" StrokeThickness="1" SnapsToDevicePixels="True" />
                    </Grid>
                    <TextBlock Text="×" Style="{StaticResource IconText}" Margin="4,0,0,0"
                               MouseLeftButtonDown="Close_Click" ToolTip="Выход" />
                </StackPanel>
            </Grid>

            <!-- ================= MAIN ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="22*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT / LIBRARY -->
                <Grid Grid.Column="0" Margin="90,64,40,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="01 // LIBRARY" FontFamily="Consolas"
                                       FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock x:Name="LibraryCountText" Text="SCANNING..."
                                       FontFamily="Consolas" FontSize="8"
                                       Foreground="#666666" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                            <Button x:Name="AddGameButton" Content="+ ADD"
                                    Style="{StaticResource Chip}" FontSize="8"
                                    Padding="8,4" Margin="0,0,6,0" Click="AddGame_Click"
                                    ToolTip="Добавить игру вручную: выбери рабочий .exe игры (например sp26-cod.exe). Нужно, если сканер не нашёл игру сам." />
                            <Button x:Name="RefreshButton" Content="REFRESH"
                                    Style="{StaticResource Chip}" FontSize="8"
                                    Padding="8,4" Margin="0" Click="Refresh_Click"
                                    ToolTip="Заново просканировать Steam, Epic, GOG и папки с играми. Установленные моды не удаляются." />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <WrapPanel x:Name="GamesPanel" Orientation="Horizontal" Width="654" />
                    </ScrollViewer>
                </Grid>

                <!-- DIVIDER -->
                <Border Grid.Column="1" Background="#2EFFFFFF" Width="1" />

                <!-- RIGHT / TERMINAL -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,0">
                    <StackPanel x:Name="RightPanel" Margin="16,24,14,12">

                        <TextBlock Text="02 // TERMINAL" FontFamily="Consolas"
                                   FontSize="8" FontWeight="Bold" Foreground="#666666" />

                        <TextBlock x:Name="SelectedNameText" Text="NO GAME SELECTED"
                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                   Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock x:Name="SelectedMetaText" Text="SELECT A TARGET //"
                                   FontFamily="Consolas" FontSize="7.5" Foreground="#555555"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                        <!-- hidden legacy verdict blocks -->
                        <TextBlock x:Name="VerdictText" Visibility="Collapsed" />
                        <TextBlock x:Name="VerdictDetailText" Visibility="Collapsed" />

                        <!-- TELEMETRY -->
                        <TextBlock Text="// TELEMETRY" Style="{StaticResource SectionLabel}" Margin="0,18,0,4" />
                        <Border BorderBrush="#222222" BorderThickness="1" Padding="7,5">
                            <StackPanel>
                                <Grid Height="17">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="CAPTURE" FontSize="7.5" Foreground="#666666" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CaptureValueText" Grid.Column="1" Text="—" FontSize="7.5" Foreground="#FFFFFF" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Height="17">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="ANTICHEAT" FontSize="7.5" Foreground="#666666" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AntiCheatValueText" Grid.Column="1" Text="—" FontSize="7.5" Foreground="#FFFFFF" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Height="17">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="DLSS_STATE" FontSize="7.5" Foreground="#666666" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DlssValueText" Grid.Column="1" Text="—" FontSize="7.5" Foreground="#FFFFFF" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Height="17">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="MULTIPLIER" FontSize="7.5" Foreground="#666666" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MultiplierValueText" Grid.Column="1" Text="[ 2X ]" FontSize="7.5" Foreground="#FFFFFF" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Height="17">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="HOTKEY" FontSize="7.5" Foreground="#666666" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HotkeyValueText" Grid.Column="1" Text="[ F9 ]" FontSize="7.5" Foreground="#FFFFFF" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="PowerButton" Content="ВКЛЮЧИТЬ УСКОРЕНИЕ"
                                Height="40" Margin="0,12,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="Power_Click"
                                ToolTip="Главная кнопка. Включает или выключает выбранный метод для этой игры. Если выбран LIVE FLOW — управляет только LIVE FLOW." />

                        <Button x:Name="LaunchButton" Content="ЗАПУСТИТЬ ИГРУ"
                                Height="40" Margin="0,8,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="Launch_Click"
                                ToolTip="Запустить игру через Steam или напрямую .exe. Если включён LIVE FLOW, он стартует сам, когда появится окно игры." />

                        <TextBlock x:Name="StatusText" Text="" FontFamily="Consolas"
                                   FontSize="7.5" Foreground="#888888"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <TextBlock Text="// METHOD" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
                        <UniformGrid Rows="2" Columns="2" Margin="0,0,0,6">
                            <Button x:Name="ModeClassicButton" Height="40" Margin="0,0,1,1"
                                    Style="{StaticResource ModeButton}"
                                    Click="Mode_Click" Uid="ClassicSm86"
                                    ToolTip="Разблокирует родной генератор кадров NVIDIA (от 2X до 6X) внутри самой игры + ускоренный INT8-апскейлер чёткости.&#10;КАК ВКЛЮЧИТЬ: Включи этот режим здесь, запусти игру и включи в её настройках «Генерация кадров DLSS».">
                                <StackPanel>
                                    <TextBlock Text="CLASSIC" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock x:Name="ClassicSubText" Text="DLSS FG // GAME SLIDER" FontSize="6.5" Margin="0,2,0,0"
                                               HorizontalAlignment="Center" Opacity="0.65"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ModeEncoreButton" Height="40" Margin="0,0,0,1"
                                    Style="{StaticResource ModeButton}"
                                    Click="Mode_Click" Uid="RtxEncore"
                                    ToolTip="Продвинутый мод-комбайн (до 6X) со своим меню внутри игры.&#10;Меняет множитель кадров и настройки во время игры по клавише меню.">
                                <StackPanel>
                                    <TextBlock Text="ENCORE" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="IN-GAME MENU // 6X" FontSize="6.5" Margin="0,2,0,0"
                                               HorizontalAlignment="Center" Opacity="0.65"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ModeSmoothButton" Height="40" Margin="0,0,1,0"
                                    Style="{StaticResource ModeButton}"
                                    Click="Mode_Click" Uid="SmoothMotion"
                                    ToolTip="Драйверный генератор кадров NVIDIA Smooth Motion (2X).&#10;Удваивает кадры на уровне видеодрайвера даже без настройки DLSS в игре.">
                                <StackPanel>
                                    <TextBlock Text="SMOOTH" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="DRIVER 2X // NO DLSS" FontSize="6.5" Margin="0,2,0,0"
                                               HorizontalAlignment="Center" Opacity="0.65"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ModeLiveFlowButton" Height="40"
                                    Style="{StaticResource ModeButton}"
                                    Click="Mode_Click" Uid="LiveFlow"
                                    ToolTip="Внешний генератор кадров (2X) через захват экрана и NVIDIA Optical Flow.&#10;Не трогает файлы игры. Работает в онлайн-играх с античитом; включается по F9 или удержанию Nitro [N].">
                                <StackPanel>
                                    <TextBlock Text="LIVE FLOW" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock x:Name="LiveFlowModeSubText" Text="SCREEN 2X // ONLINE" FontSize="6.5" Margin="0,2,0,0"
                                               HorizontalAlignment="Center" Opacity="0.65"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <TextBlock x:Name="AntiCheatHint" Text="LOCK // ANTI-CHEAT INSTALLED"
                                   FontFamily="Consolas" FontSize="7" FontWeight="Bold" Foreground="#B0B0B0"
                                   TextWrapping="Wrap" Margin="0,4,0,2" Visibility="Collapsed" />

                        <CheckBox x:Name="EacToggle" Content="UNLOCK PROXY IN ANTI-CHEAT"
                                  Style="{StaticResource SmallCheck}"
                                  Margin="0,5,0,6" Click="Eac_Click"
                                  ToolTip="Снимает запрет на моды в играх с античитом. Включай только если понимаешь риск бана. Состояние сохраняется." />

                        <StackPanel x:Name="ClassicQualityPanel" Visibility="Collapsed" Margin="0,2,0,6">
                            <TextBlock Text="// CLASSIC QUALITY" Style="{StaticResource SectionLabel}" />
                            <WrapPanel>
                                <Button x:Name="ClassicSharpButton" Content="M-INT8" Uid="sharp"
                                        Style="{StaticResource Chip}" Click="ClassicProfile_Click"
                                        ToolTip="M-INT8 (Ультра-чёткость): новая нейросеть Transformer Preset M на INT8-ядрах RTX 3060. Максимально чёткая картинка без мыла." />
                                <Button x:Name="ClassicFpsButton" Content="OFF + FG-LITE" Uid="fps"
                                        Style="{StaticResource Chip}" Click="ClassicProfile_Click"
                                        ToolTip="Макс. FPS: родной лёгкий апскейлер игры + быстрый пресет FG Lite (Preset C). Максимальный прирост FPS." />
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock Text="// MULTIPLIER" Style="{StaticResource SectionLabel}" Margin="0,6,0,4" />
                        <WrapPanel>
                            <Button x:Name="Frames2" Content="[ 2X ]" Uid="2"
                                    Style="{StaticResource Chip}" Click="Multiplier_Click"
                                    ToolTip="Удваивает FPS: 1 сгенерированный кадр на 1 реальный. Минимальная задержка и артефакты." />
                            <Button x:Name="Frames3" Content="[ 3X ]" Uid="3"
                                    Style="{StaticResource Chip}" Click="Multiplier_Click"
                                    ToolTip="Утраивает FPS: 2 сгенерированных кадра на 1 реальный. Баланс плавности и отзывчивости." />
                            <Button x:Name="Frames4" Content="[ 4X ]" Uid="4"
                                    Style="{StaticResource Chip}" Click="Multiplier_Click"
                                    ToolTip="Учетверяет FPS: 3 сгенерированных кадра на 1 реальный. Для мониторов 144–240 Гц." />
                            <Button x:Name="Frames6" Content="[ 6X ]" Uid="6"
                                    Style="{StaticResource Chip}" Click="Multiplier_Click"
                                    ToolTip="6X: 5 сгенерированных кадров на 1 реальный. Экстремальная плавность для сюжетных игр." />
                        </WrapPanel>

                        <Border Height="1" Background="#222222" Margin="0,8,0,10" />

                        <CheckBox x:Name="EncoreMenuToggle" Content="ENCORE IN-GAME MENU"
                                  Style="{StaticResource SmallCheck}"
                                  Margin="0,0,0,6" Click="EncoreMenu_Click"
                                  ToolTip="Показывает меню Encore по клавише меню. Если игра защищает Present (CoD/sp26), меню принудительно отключается." />

                        <Button x:Name="MenuKeyButton" Content="MENU KEY // F8"
                                Style="{StaticResource Chip}" FontSize="8"
                                Padding="8,5" Margin="0,0,0,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Click="MenuKey_Click"
                                ToolTip="Нажми и потом нужную клавишу. В игре эта клавиша нажимает Insert для меню Encore. Esc — отмена." />
                        <TextBlock x:Name="MenuKeyHint" Text="ESC // CANCEL"
                                   FontFamily="Consolas" FontSize="6.5" Foreground="#555555"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />

                        <Button x:Name="LiveFlowKeyButton" Content="LIVE FLOW KEY // F9"
                                Style="{StaticResource Chip}" FontSize="8"
                                Padding="8,5" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Click="LiveFlowKey_Click"
                                ToolTip="Нажми и потом нужную клавишу. В игре она мгновенно включает и выключает LIVE FLOW. Esc — отмена." />
                        <TextBlock x:Name="LiveFlowKeyHint" Text="ESC // CANCEL"
                                   FontFamily="Consolas" FontSize="6.5" Foreground="#555555"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />

                        <Button x:Name="RemoveModButton" Content="СНЯТЬ МОД"
                                Style="{StaticResource DangerButton}"
                                Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="RemoveMod_Click"
                                ToolTip="Удаляет из папки игры ВСЕ файлы модов. Автоматически при запуске ничего не удаляется — только по этой кнопке." />

                        <TextBlock Text="LIVE FLOW // EXTERNAL CAPTURE // NO GAME FILES"
                                   FontFamily="Consolas" FontSize="6.5" Foreground="#444444"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= FOOTER ================= -->
            <Grid Grid.Row="2" Margin="12,0,12,0">
                <Border Height="1" Background="#1AFFFFFF" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceText" Text="" FontFamily="Consolas"
                           FontSize="7.5" Foreground="#444444" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="ALPHA BUILD // ERRORS POSSIBLE"
                           FontFamily="Consolas" FontSize="7.5" FontWeight="Bold"
                           Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterHint" Text="NITRO [N] // 0.6S // TRAY // LF 2X // F9"
                           FontFamily="Consolas" FontSize="7.5" Foreground="#444444"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
