<Window x:Class="CHZMFRAMEUNLOCK1.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" Height="92"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False" IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        FontFamily="Consolas" SnapsToDevicePixels="True">
    <Border x:Name="RootBorder" Background="#F0000000" BorderBrush="#FFFFFF"
            BorderThickness="1" CornerRadius="0" Padding="14,9">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="SYSTEM // TELEMETRY"
                       FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                       Foreground="#FFFFFF" />
            <TextBlock x:Name="BodyText" Text=""
                       FontFamily="Consolas" FontSize="8.5" Foreground="#888888" Margin="0,4,0,0"
                       TextWrapping="Wrap" MaxWidth="390" />
        </StackPanel>
    </Border>
</Window>
